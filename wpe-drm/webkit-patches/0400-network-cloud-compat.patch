+static bool allowExpiredCloudGameWebSocketCertificate(SoupMessage* message, GTlsCertificateFlags errors)
+{
+    const char* enabled = g_getenv("WPE_CLOUDGAME_ALLOW_EXPIRED_TLS");
+    if (!enabled || strcmp(enabled, "1") || errors != G_TLS_CERTIFICATE_EXPIRED)
+        return false;
+
+    GUri* uri = soup_message_get_uri(message);
+    const char* host = uri ? g_uri_get_host(uri) : nullptr;
+    static constexpr char suffix[] = ".mhystatic.com";
+    if (!host || g_uri_get_port(uri) != 5443)
+        return false;
+
+    size_t hostLength = strlen(host);
+    constexpr size_t suffixLength = sizeof(suffix) - 1;
+    if (hostLength <= suffixLength
+        || g_ascii_strcasecmp(host + hostLength - suffixLength, suffix))
+        return false;
+
+    g_warning("Allowing expired cloud-game WSS certificate for host=%s port=5443 errors=0x%x",
+        host, static_cast<unsigned>(errors));
+    return true;
+}

+class SkiaBackingStore::PendingGPUReads {
+    WTF_MAKE_TZONE_ALLOCATED(PendingGPUReads);
+public:
+    ~PendingGPUReads()
+    {
+#if USE(GLIB) && OS(UNIX)
+        if (!m_retirement.finish(2000))
+            g_error("Skia tile upload teardown: GPU read fence did not complete");
+#endif
+    }
+
+    void retain(Vector<Ref<CoordinatedTileBuffer>>&& buffers)
+    {
+        if (buffers.isEmpty())
+            return;
+#if USE(GLIB) && OS(UNIX)
+        auto fence = GLFence::createExportable(PlatformDisplay::sharedDisplay().glDisplay());
+        auto fd = fence ? fence->exportFD() : WTF::UnixFileDescriptor { };
+        if (fd) {
+            struct Batch { Vector<Ref<CoordinatedTileBuffer>> buffers; };
+            auto* batch = new Batch { WTF::move(buffers) };
+            int rawFD = fd.release();
+            auto enqueue = [&] {
+                return m_retirement.retain(rawFD, batch,
+                    +[](void* data) { static_cast<Batch*>(data)->buffers.clear(); },
+                    +[](void* data) { delete static_cast<Batch*>(data); },
+                    g_main_context_get_thread_default());
+            };
+            if (!enqueue() && (!m_retirement.finish(2000) || !enqueue()))
+                g_error("Skia tile upload retention exhausted; refusing unsafe texture reuse");
+            return;
+        }
+#endif
+        // Without exportable fences, complete GL reads before releasing pool references.
+        glFinish();
+    }
+
+private:
+#if USE(GLIB) && OS(UNIX)
+    WPE::DRM::RenderingFenceRetirement m_retirement;
+#endif
+};

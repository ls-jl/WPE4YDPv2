 }
 
 void SkiaBackingStore::Tile::ensureTexture(const IntSize& size, CoordinatedTileBuffer& buffer)
 {
     OptionSet<BitmapTexture::Flags> flags;
     if (buffer.supportsAlpha())
         flags.add(BitmapTexture::Flags::SupportsAlpha);
     if (buffer.pixelFormat() == PixelFormat::BGRA8)
         flags.add(BitmapTexture::Flags::UseBGRALayout);
 
 #if USE(GBM)
     if (SkiaPaintingEngine::shouldUseLinearTileTextures()) {
         flags.add(BitmapTexture::Flags::BackedByDMABuf);
         flags.add(BitmapTexture::Flags::ForceLinearBuffer);
     } else if (SkiaPaintingEngine::shouldUseVivanteSuperTiledTileTextures()) {
         flags.add(BitmapTexture::Flags::BackedByDMABuf);
         flags.add(BitmapTexture::Flags::ForceVivanteSuperTiledBuffer);
     }
 #endif
 
     if (m_texture) {
         if (buffer.supportsAlpha() == m_texture->isOpaque())
             m_texture->reset(size, flags);
     } else {
         m_texture = BitmapTexturePool::singleton().acquireTexture(size, flags);
         m_cachedImage = nullptr;
     }
 }
 
 void SkiaBackingStore::Tile::update(const IntRect& dirtyRect, const IntRect& tileRect, CoordinatedTileBuffer& buffer, Vector<Ref<CoordinatedTileBuffer>>& pendingGPUReads)
 {
     WTFBeginSignpost(this, SkiaBackingStoreTileUpdate, "rect %ix%i+%i+%i %s", tileRect.x(), tileRect.y(), tileRect.width(), tileRect.height(), buffer.isBackedByOpenGL() ? "GPUToGPU" : useSkiaCPURasterCompositorForBackingStore() ? "CPUToCPU" : "CPUToGPU");
 
     // Async scrolling can consume an update while its painting worker is
     // still publishing the texture and fence. Match the TextureMapper path.
     buffer.waitUntilPaintingComplete();
     // Borrowed SkImages are immutable to Skia even when external GL modifies
     // their texture. Every update must create a new image identity.
     m_cachedImage = nullptr;
 
     FloatRect unscaledTileRect(tileRect);
     unscaledTileRect.scale(1. / m_scale);
 
     if (unscaledTileRect != m_rect) {
         m_rect = unscaledTileRect;
-        m_texture = nullptr;
+        retireTexture(pendingGPUReads);
         m_surface = nullptr;
         m_cachedImage = nullptr;
     }
 
     if (buffer.isBackedByOpenGL()) {
         auto& acceleratedBuffer = static_cast<CoordinatedAcceleratedTileBuffer&>(buffer);
         acceleratedBuffer.serverWait();
 
         if (auto displayList = acceleratedBuffer.displayList()) {
             ASSERT(!m_texture);
             ASSERT(!m_cachedImage);
 
             auto* grContext = PlatformDisplay::sharedDisplay().skiaGrContext();
             ASSERT(grContext);
 
             if (!m_surface) {
                 const auto& characterization = displayList->characterization();
                 m_surface = SkSurfaces::RenderTarget(grContext, skgpu::Budgeted::kYes, characterization.imageInfo(), characterization.sampleCount(), characterization.origin(), &characterization.surfaceProps());
             }
 
             skgpu::ganesh::DrawDDL(m_surface.get(), displayList);
         } else if (auto texture = acceleratedBuffer.texture()) {
             ASSERT(!m_surface);
 
             if (dirtyRect.size() == tileRect.size()) {
                 // Keep texture identity stable for previously submitted SkImages.
                 // Their release callbacks retain the old pool entry until GPU reads finish.
+                retireTexture(pendingGPUReads);
                 m_texture = WTF::move(texture);
                 m_cachedImage = nullptr;
             } else {
-                ensureTexture(tileRect.size(), buffer);
+                // Pool + tile own two refs. A third ref means an immutable
+                // borrowed SkImage (or an outstanding upload) still reads it.
+                if (m_texture && m_texture->refCount() > 2) {
+                    auto previousTexture = WTF::move(m_texture);
+                    ensureTexture(tileRect.size(), buffer);
+                    m_texture->copyFromExternalTexture(previousTexture->id(), IntRect({ }, tileRect.size()), { });
+                    pendingGPUReads.append(CoordinatedAcceleratedTileBuffer::create(previousTexture.releaseNonNull()));
+                } else
+                    ensureTexture(tileRect.size(), buffer);
                 m_texture->copyFromExternalTexture(texture->id(), dirtyRect, { });
                 // A server wait orders the producer write, not this consumer read.
                 // Keep the source out of the shared pool until the copy fence signals.
                 pendingGPUReads.append(Ref { buffer });
             }
         }
     } else {
         auto& unacceleratedBuffer = static_cast<CoordinatedUnacceleratedTileBuffer&>(buffer);
         if (useSkiaCPURasterCompositorForBackingStore()) {
             if (!m_surface) {
                 auto surfaceInfo = SkImageInfo::Make(tileRect.width(), tileRect.height(), kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
                 m_surface = SkSurfaces::Raster(surfaceInfo);
                 if (m_surface)
                     m_surface->getCanvas()->clear(SK_ColorTRANSPARENT);
             }
             if (m_surface) {
                 auto sourceSize = buffer.size();
                 auto sourceInfo = SkImageInfo::Make(sourceSize.width(), sourceSize.height(), kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
                 SkPixmap sourcePixels(sourceInfo, unacceleratedBuffer.data(), unacceleratedBuffer.stride());
                 m_surface->writePixels(sourcePixels, dirtyRect.x(), dirtyRect.y());
             }
             m_texture = nullptr;
             m_cachedImage = nullptr;
         } else {
             ensureTexture(tileRect.size(), buffer);
             m_texture->updateContents(unacceleratedBuffer.data(), dirtyRect, { }, unacceleratedBuffer.stride(), buffer.pixelFormat());
         }
     }
 
     WTFEndSignpost(this, SkiaBackingStoreTileUpdate);

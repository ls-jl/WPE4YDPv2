+static gboolean webkitMediaStreamSrcAttachDeferredPlayerAudio(gpointer userData)
+{
+    auto self = WEBKIT_MEDIA_STREAM_SRC_CAST(userData);
+    auto priv = self->priv;
+    if (priv->deferredPlayerAudioTracks.isEmpty()) {
+        priv->deferredPlayerAudioTimer = 0;
+        return G_SOURCE_REMOVE;
+    }
 
+    bool videoReady = false;
+    for (auto& source : priv->sources.values()) {
+        auto track = source->track();
+        if (track && track->isVideo() && source->hasPrerolled()) {
+            videoReady = true;
+            break;
+        }
+    }
+
+    ++priv->deferredPlayerAudioPolls;
+    if (!videoReady) {
+        if (priv->deferredPlayerAudioPolls < 200)
+            return G_SOURCE_CONTINUE;
+
+        g_print("WebRTC player audio defer timed out after 10s; keeping video-only playback\n");
+        priv->deferredPlayerAudioTracks.clear();
+        priv->deferredPlayerAudioTimer = 0;
+        return G_SOURCE_REMOVE;
+    }
+
+    if (++priv->deferredPlayerAudioReadyPolls < 5)
+        return G_SOURCE_CONTINUE;
+
+    auto tracks = WTF::move(priv->deferredPlayerAudioTracks);
+    priv->deferredPlayerAudioTimer = 0;
+    g_print("WebRTC player audio attaching after video preroll: tracks=%zu delay_polls=%u\n",
+        tracks.size(), priv->deferredPlayerAudioPolls);
+    for (auto& track : tracks) {
+        if (track)
+            webkitMediaStreamSrcAddTrack(self, track.get(), true);
+    }
+    webkitMediaStreamSrcEnsureStreamCollectionPosted(self);
+    return G_SOURCE_REMOVE;
+}

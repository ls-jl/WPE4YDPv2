From: WPE4YDPv2 maintainers
Subject: [PATCH] WebRTC: decouple decoded video samples from the MPP pool

The Rockchip MPP decoder exposes a small output pool. WebKit forwards each
decoded GstBuffer into a VideoFrame and the MediaStream playback pipeline,
where the buffer can be retained for much longer than the decoder expects.
After two output frames the MPP pool can therefore stop, while RTP continues
to arrive and the receive queue eventually overruns.

Add an explicit embedded-runtime switch that deep-copies decoded incoming
video at the fakesink handoff. The downstream MediaStream pipeline owns the
copy, so the original MPP output buffer is released as soon as the handoff
returns. Keep upstream behavior unchanged unless the switch is enabled.

---
 .../gstreamer/RealtimeIncomingSourceGStreamer.cpp   | 25 ++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/Source/WebCore/platform/mediastream/gstreamer/RealtimeIncomingSourceGStreamer.cpp b/Source/WebCore/platform/mediastream/gstreamer/RealtimeIncomingSourceGStreamer.cpp
--- a/Source/WebCore/platform/mediastream/gstreamer/RealtimeIncomingSourceGStreamer.cpp
+++ b/Source/WebCore/platform/mediastream/gstreamer/RealtimeIncomingSourceGStreamer.cpp
@@ -39,6 +39,12 @@ static bool coalesceIncomingVideoSamples()
     return value && !g_strcmp0(value, "1");
 }
 
+static bool copyIncomingDecodedVideoSamples()
+{
+    const char* value = g_getenv("WEBKIT_GST_WEBRTC_COPY_DECODED_VIDEO");
+    return value && !g_strcmp0(value, "1");
+}
+
 RealtimeIncomingSourceGStreamer::RealtimeIncomingSourceGStreamer(const CaptureDevice& device)
     : RealtimeMediaSource(device)
 {
@@ -56,8 +62,25 @@ bool RealtimeIncomingSourceGStreamer::setBin(GRefPtr<GstElement>&& bin)
 
     auto handoffCallback = G_CALLBACK(+[](GstElement*, GstBuffer* buffer, GstPad* pad, gpointer userData) {
         auto source = reinterpret_cast<RealtimeIncomingSourceGStreamer*>(userData);
+        GstBuffer* sampleBuffer = buffer;
+        GRefPtr<GstBuffer> copiedBuffer;
+        if (source->isIncomingVideoSource() && copyIncomingDecodedVideoSamples()) {
+            copiedBuffer = adoptGRef(gst_buffer_copy_deep(buffer));
+            if (!copiedBuffer) {
+                GST_ERROR_OBJECT(source->m_bin.get(), "Failed to copy decoded incoming video sample");
+                return;
+            }
+            sampleBuffer = copiedBuffer.get();
+
+            static std::once_flag logged;
+            std::call_once(logged, [source] {
+                GST_WARNING_OBJECT(source->m_bin.get(),
+                    "Deep-copying decoded incoming video to release the decoder output pool");
+            });
+        }
+
         auto caps = adoptGRef(gst_pad_get_current_caps(pad));
-        auto sample = adoptGRef(gst_sample_new(buffer, caps.get(), nullptr, nullptr));
+        auto sample = adoptGRef(gst_sample_new(sampleBuffer, caps.get(), nullptr, nullptr));
         source->enqueueSample(WTF::move(sample));
     });
     g_signal_connect(m_sink.get(), "preroll-handoff", handoffCallback, this);
-- 
2.39.5

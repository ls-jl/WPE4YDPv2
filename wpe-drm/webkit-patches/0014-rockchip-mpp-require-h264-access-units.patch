From: WPE4YDPv2 maintainers
Subject: [PATCH] GStreamer: advertise the Rockchip MPP H.264 AU requirement

The old Rockchip mppvideodec factory advertises parsed H.264 without an
alignment restriction. It is consequently linked to NAL-aligned output, even
though the decoder operates on complete access units. The final MediaStream
pipeline then remains pending PLAYING and its appsrc queue stops draining.

When explicitly enabled for a MediaStream player, constrain H.264 CAPS and
ACCEPT_CAPS queries on the instantiated MPP sink pad to byte-stream access
units. This makes h264parse negotiate alignment=au without changing the
vendor plugin or affecting normal media playback by default.

---
 .../gstreamer/MediaPlayerPrivateGStreamer.cpp      | 61 ++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
--- a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
@@ -2723,6 +2723,12 @@ void MediaPlayerPrivateGStreamer::configureUriDecodebin2(GstElement* element)
 #endif
 }
 
+static bool requireRockchipMppH264AccessUnits()
+{
+    const char* value = g_getenv("WEBKIT_GST_MPP_REQUIRE_H264_AU");
+    return value && !g_strcmp0(value, "1");
+}
+
 void MediaPlayerPrivateGStreamer::configureElement(GstElement* element)
 {
     configureElementPlatformQuirks(element);
@@ -2746,6 +2752,61 @@ void MediaPlayerPrivateGStreamer::configureElement(GstElement* element)
         }
     }
 
+    if (isMediaStreamPlayer() && requireRockchipMppH264AccessUnits()) {
+        auto* factory = gst_element_get_factory(element);
+        if (factory && !g_strcmp0(GST_OBJECT_NAME(factory), "mppvideodec")
+            && !g_object_get_data(G_OBJECT(element), "webkit-mpp-h264-au-probe")) {
+            auto sinkPad = adoptGRef(gst_element_get_static_pad(element, "sink"));
+            if (sinkPad) {
+                gst_pad_add_probe(sinkPad.get(), GST_PAD_PROBE_TYPE_QUERY_DOWNSTREAM,
+                    +[](GstPad*, GstPadProbeInfo* info, gpointer) -> GstPadProbeReturn {
+                        auto* query = GST_PAD_PROBE_INFO_QUERY(info);
+                        if (!query)
+                            return GST_PAD_PROBE_OK;
+
+                        if (GST_QUERY_TYPE(query) == GST_QUERY_ACCEPT_CAPS) {
+                            GstCaps* caps = nullptr;
+                            gst_query_parse_accept_caps(query, &caps);
+                            if (!caps || !doCapsHaveType(caps, "video/x-h264"_s))
+                                return GST_PAD_PROBE_OK;
+
+                            bool accepted = true;
+                            for (unsigned i = 0; i < gst_caps_get_size(caps); ++i) {
+                                auto* structure = gst_caps_get_structure(caps, i);
+                                const char* alignment = gst_structure_get_string(structure, "alignment");
+                                const char* streamFormat = gst_structure_get_string(structure, "stream-format");
+                                gboolean parsed = FALSE;
+                                accepted &= alignment && !g_strcmp0(alignment, "au");
+                                accepted &= streamFormat && !g_strcmp0(streamFormat, "byte-stream");
+                                accepted &= gst_structure_get_boolean(structure, "parsed", &parsed) && parsed;
+                            }
+                            gst_query_set_accept_caps_result(query, accepted);
+                            return GST_PAD_PROBE_HANDLED;
+                        }
+
+                        if (GST_QUERY_TYPE(query) != GST_QUERY_CAPS)
+                            return GST_PAD_PROBE_OK;
+
+                        GstCaps* filter = nullptr;
+                        gst_query_parse_caps(query, &filter);
+                        if (filter && !doCapsHaveType(filter, "video/x-h264"_s))
+                            return GST_PAD_PROBE_OK;
+
+                        auto requiredCaps = adoptGRef(gst_caps_new_simple("video/x-h264",
+                            "parsed", G_TYPE_BOOLEAN, TRUE,
+                            "stream-format", G_TYPE_STRING, "byte-stream",
+                            "alignment", G_TYPE_STRING, "au", nullptr));
+                        if (filter)
+                            requiredCaps = adoptGRef(gst_caps_intersect_full(filter, requiredCaps.get(), GST_CAPS_INTERSECT_FIRST));
+                        gst_query_set_caps_result(query, requiredCaps.get());
+                        return GST_PAD_PROBE_HANDLED;
+                    }, nullptr, nullptr);
+                g_object_set_data(G_OBJECT(element), "webkit-mpp-h264-au-probe", GINT_TO_POINTER(1));
+                GST_WARNING_OBJECT(element, "Constraining Rockchip MPP H.264 input to parsed byte-stream access units");
+            }
+        }
+    }
+
     auto name = GMallocString::unsafeAdoptFromUTF8(gst_element_get_name(element));
     String elementClass(unsafeSpan(gst_element_get_metadata(element, GST_ELEMENT_METADATA_KLASS)));
     auto classifiers = elementClass.split('/');
-- 

+static void constrainH264ParserToAccessUnits(GstElement* parser)
+{
+    if (!requireRockchipMppH264AccessUnits()
+        || g_object_get_data(G_OBJECT(parser), "webkit-mpp-early-h264-au-probe"))
+        return;

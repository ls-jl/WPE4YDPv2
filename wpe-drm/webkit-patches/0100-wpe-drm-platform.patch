+    }
+    return {
+        0xfff1f3f4, 0xfff8f9fa, 0xffffffff, 0xffeef3f8,
+        0xffd2d8df, 0xff202124, 0xff5f6368, 0xff9aa0a6,
+        0xff1a73e8, 0xffffffff, 0x301a73e8, 0xffd93025,

diff --git a/Source/WebKit/WPEPlatform/wpe/drm/WPEDRMSeat.cpp b/Source/WebKit/WPEPlatform/wpe/drm/WPEDRMSeat.cpp
index cf817133ec994b9670b5d1f560cad1964155faff..740511fbfbaabea912fc81d41113bef06fb2b870 100644
--- a/Source/WebKit/WPEPlatform/wpe/drm/WPEDRMSeat.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/drm/WPEDRMSeat.cpp
@@ -32,6 +32,7 @@
 #include "WPESettings.h"
 #include "WPEViewDRMPrivate.h"
 #include <linux/input.h>
+#include <sys/stat.h>
 #include <wtf/MonotonicTime.h>
 #include <wtf/TZoneMallocInlines.h>
 #include <wtf/glib/RunLoopSourcePriority.h>
@@ -47,6 +48,24 @@ static struct libinput_interface s_libinputInterface = {
     [](const char* path, int flags, void* userData) -> int
     {
         auto& session = *static_cast<Session*>(userData);
+
+        // The direct DRM launcher reads this touchscreen itself so it can apply
+        // panel rotation, native chrome hit testing and game multi-touch. Do
+        // not let libinput open a second file description for the same evdev
+        // node: independent evdev readers compete for events instead of each
+        // receiving a copy.
+        const char* rawTouchDevice = g_getenv("WPE_TOUCH_DEVICE");
+        if (rawTouchDevice && rawTouchDevice[0]
+            && g_strcmp0(g_getenv("WPE_RAW_TOUCH_EXCLUSIVE"), "0")) {
+            struct stat pathStat;
+            struct stat rawTouchStat;
+            if (!stat(path, &pathStat) && !stat(rawTouchDevice, &rawTouchStat)
+                && S_ISCHR(pathStat.st_mode) && S_ISCHR(rawTouchStat.st_mode)
+                && pathStat.st_rdev == rawTouchStat.st_rdev) {
+                g_message("WPE DRM: reserving raw touch device %s (libinput path %s)", rawTouchDevice, path);
+                return -EACCES;
+            }
+        }
         return session.openDevice(path, flags);
     },
     // close_restricted

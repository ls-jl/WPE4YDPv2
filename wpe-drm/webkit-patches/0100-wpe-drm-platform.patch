+static void videoOverlayRecordCommit(VideoOverlayState* overlay, int64_t durationUS)
+{
+    if (durationUS < 0)
+        return;
+    overlay->commitTotalUS += durationUS;
+    overlay->commitMaxUS = std::max<uint64_t>(overlay->commitMaxUS, durationUS);

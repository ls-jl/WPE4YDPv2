+void ThreadedCompositor::updateCompositorStatistics(Seconds composeDuration)
+{
+    auto now = MonotonicTime::now();
+    if (!m_compositorStatistics.windowStart)
+        m_compositorStatistics.windowStart = now;
+
+    ++m_compositorStatistics.frameCount;
+    m_compositorStatistics.composeTotal += composeDuration;
+    if (composeDuration > m_compositorStatistics.composeMax)
+        m_compositorStatistics.composeMax = composeDuration;
+
+    auto elapsed = now - m_compositorStatistics.windowStart;
+    if (elapsed < 2_s)
+        return;
+
+    auto frameCount = m_compositorStatistics.frameCount;
+    auto fps = frameCount / elapsed.seconds();
+    auto averageMS = frameCount ? m_compositorStatistics.composeTotal.milliseconds() / frameCount : 0.;
+    WTFLogAlways("ThreadedCompositor window compositor_path=%s fps=%.1f compose_avg_ms=%.2f compose_max_ms=%.2f frames=%u",
+        m_surface->usesGL() ? "skia_gpu" : "skia_raster_shm", fps, averageMS, m_compositorStatistics.composeMax.milliseconds(), frameCount);
+
+    m_compositorStatistics.windowStart = now;
+    m_compositorStatistics.frameCount = 0;
+    m_compositorStatistics.composeTotal = 0_s;
+    m_compositorStatistics.composeMax = 0_s;
+}

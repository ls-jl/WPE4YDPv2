From: WPE4YDPv2 maintainers
Subject: [PATCH] GStreamer: negotiate H.264 access units before MPP creation

The Rockchip MPP sink-pad guard added by the previous patch runs after
parsebin has already selected NAL-aligned H.264 output. Rejecting those caps
at decoder creation time cannot make h264parse renegotiate and leaves the
MediaStream player without a decoder.

Handle parsebin's autoplug-query while h264parse is still unexposed. For the
opt-in MediaStream path, advertise parsed byte-stream access units as the
downstream requirement. The existing decoder guard then validates the
negotiated result instead of trying to change it too late.

---
 .../gstreamer/MediaPlayerPrivateGStreamer.cpp | 41 +++++++++++++++----
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
--- a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
@@ -2647,6 +2647,12 @@ void MediaPlayerPrivateGStreamer::processTableOfContentsEntry(GstTocEntry* entry)
     for (GList* i = gst_toc_entry_get_sub_entries(entry); i; i = i->next)
         processTableOfContentsEntry(static_cast<GstTocEntry*>(i->data));
 }
+
+static bool requireRockchipMppH264AccessUnits()
+{
+    const char* value = g_getenv("WEBKIT_GST_MPP_REQUIRE_H264_AU");
+    return value && !g_strcmp0(value, "1");
+}
 
 void MediaPlayerPrivateGStreamer::configureParsebin(GstElement* parsebin)
 {
@@ -2656,6 +2662,35 @@ void MediaPlayerPrivateGStreamer::configureParsebin(GstElement* parsebin)
         return TRUE;
     }), this);
 
+    g_signal_connect(parsebin, "autoplug-query",
+        G_CALLBACK(+[](GstElement*, GstPad*, GstElement* childElement, GstQuery* query, MediaPlayerPrivateGStreamer* player) -> gboolean {
+            if (!player->isMediaStreamPlayer() || !requireRockchipMppH264AccessUnits() || GST_QUERY_TYPE(query) != GST_QUERY_CAPS)
+                return FALSE;
+
+            auto* factory = gst_element_get_factory(childElement);
+            if (!factory || g_strcmp0(GST_OBJECT_NAME(factory), "h264parse"))
+                return FALSE;
+
+            GstCaps* filter = nullptr;
+            gst_query_parse_caps(query, &filter);
+            if (filter && !gst_caps_is_any(filter) && !doCapsHaveType(filter, "video/x-h264"_s))
+                return FALSE;
+
+            auto requiredCaps = adoptGRef(gst_caps_new_simple("video/x-h264",
+                "parsed", G_TYPE_BOOLEAN, TRUE,
+                "stream-format", G_TYPE_STRING, "byte-stream",
+                "alignment", G_TYPE_STRING, "au", nullptr));
+            if (filter)
+                requiredCaps = adoptGRef(gst_caps_intersect_full(filter, requiredCaps.get(), GST_CAPS_INTERSECT_FIRST));
+
+            gst_query_set_caps_result(query, requiredCaps.get());
+            if (!g_object_get_data(G_OBJECT(childElement), "webkit-mpp-h264-au-query-logged")) {
+                g_object_set_data(G_OBJECT(childElement), "webkit-mpp-h264-au-query-logged", GINT_TO_POINTER(1));
+                GST_WARNING_OBJECT(childElement, "Advertising downstream Rockchip MPP H.264 AU caps: %" GST_PTR_FORMAT, requiredCaps.get());
+            }
+            return TRUE;
+        }), this);
+
     // We can save some overhead by not parsing again streams that are already parsed and that
     // the caps match the decoder's. In that case, we can skip creating a parser element in parsebin.
     g_signal_connect(parsebin, "autoplug-select",
@@ -2730,12 +2765,6 @@ void MediaPlayerPrivateGStreamer::configureUriDecodebin2(GstElement* element)
 #endif
 }
 
-static bool requireRockchipMppH264AccessUnits()
-{
-    const char* value = g_getenv("WEBKIT_GST_MPP_REQUIRE_H264_AU");
-    return value && !g_strcmp0(value, "1");
-}
-
 void MediaPlayerPrivateGStreamer::configureElement(GstElement* element)
 {
     configureElementPlatformQuirks(element);
-- 

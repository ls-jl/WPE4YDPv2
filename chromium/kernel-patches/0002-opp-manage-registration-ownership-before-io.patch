+/* Returns resources only; the caller still owns/protects the table reference. */
+static int _opp_return_regulator_handles(struct opp_table *table)
+{
+	int ret = 0;
+	int i;
+
+	if (table->regulators) {
+		for (i = table->regulator_count - 1; i >= 0; --i) {
+			struct regulator *regulator = table->regulators[i];
+			bool active;
+			int err;
+
+			if (!regulator)
+				continue;
+			active = table->enabled || (table->regulator_release_active &&
+						  table->regulator_release_active[i]);
+			err = active ? regulator_disable(regulator) : 0;
+			if (err) {
+				if (!ret)
+					ret = err;
+				continue;
+			}
+			regulator_put(regulator);
+			table->regulators[i] = NULL;
+		}
+	}
+	if (ret)
+		return ret;
+	mutex_lock(&table->lock);
+	_free_set_opp_data(table);
+	kfree(table->regulators);
+	table->regulators = NULL;
+	table->regulator_count = -1;
+	table->enabled = false;
+	kfree(table->regulator_release_active);
+	table->regulator_release_active = NULL;
+	mutex_lock(&opp_regulator_quarantine_lock);
+	list_del_init(&table->regulator_release_node);
+	table->regulator_release_path[0] = '\0';
+	mutex_unlock(&opp_regulator_quarantine_lock);
+	/* Managed waiters must never reopen a closed, still-borrowed table. */
+	if (!table->regulator_release_managed)
+		WRITE_ONCE(table->regulator_release_pending, false);
+	mutex_unlock(&table->lock);
+	return 0;
+}

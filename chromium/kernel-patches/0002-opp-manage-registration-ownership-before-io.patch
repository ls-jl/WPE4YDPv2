+/* Caller holds table->lock and has already selected ownership mode. */
+static int _opp_publish_regulator_release(struct device *dev,
+					  struct opp_table *table)
+{
+	struct opp_table *other;
+	bool conflict = false;
+
+	if (dev->of_node && strscpy(table->regulator_release_path,
+				   of_node_full_name(dev->of_node),
+				   sizeof(table->regulator_release_path)) < 0) {
+		table->regulator_release_path[0] = '\0';
+		return -ENAMETOOLONG;
+	}
+	table->regulator_release_dev = get_device(dev);
+	mutex_lock(&opp_regulator_quarantine_lock);
+	if (table->regulator_release_managed) {
+		list_for_each_entry(other, &opp_regulator_quarantined,
+				    regulator_release_node) {
+			if (_opp_regulator_release_matches(other, dev)) {
+				conflict = true;
+				break;
+			}
+		}
+	}
+	if (!conflict)
+		list_add_tail(&table->regulator_release_node, &opp_regulator_quarantined);
+	mutex_unlock(&opp_regulator_quarantine_lock);
+	if (conflict) {
+		table->regulator_release_dev = NULL;
+		table->regulator_release_path[0] = '\0';
+		put_device(dev);
+		return -EBUSY;
+	}
+	return 0;
+}

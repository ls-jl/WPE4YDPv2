diff --git a/drivers/opp/core.c b/drivers/opp/core.c
index b806bcc..6e6838f 100644
--- a/drivers/opp/core.c
+++ b/drivers/opp/core.c
@@ -1305,6 +1305,8 @@ static void _opp_table_kref_release(struct kref *kref)

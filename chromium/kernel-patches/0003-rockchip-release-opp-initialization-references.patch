+static void rockchip_opp_put_clk(void *data)
+{
+	clk_put(data);
+}
+
 int rockchip_init_opp_table(struct device *dev, struct rockchip_opp_info *info,
 			    char *lkg_name, char *reg_name)
 {
 	struct device_node *np;
+	struct opp_table *prop_table = NULL;
 	int bin = -EINVAL, process = -EINVAL;
 	int scale = 0, volt_sel = -EINVAL;
 	int ret = 0, num_clks = 0, i;
@@ -1767,6 +1775,8 @@ int rockchip_init_opp_table(struct device *dev, struct rockchip_opp_info *info,
 	if (!info)
 		goto next;
 	info->dev = dev;
+	info->num_clks = 0;
+	info->clks = NULL;
 
 	num_clks = of_clk_get_parent_count(np);
 	if (num_clks > 0) {
@@ -1780,10 +1790,18 @@ int rockchip_init_opp_table(struct device *dev, struct rockchip_opp_info *info,
 			info->clks[i].clk = of_clk_get(np, i);
 			if (IS_ERR(info->clks[i].clk)) {
 				ret = PTR_ERR(info->clks[i].clk);
+				info->clks[i].clk = NULL;
 				dev_err(dev, "%s: failed to get clk %d\n",
 					np->name, i);
 				goto out;
 			}
+			/* No action retains info/kbdev; release precedes the devm array. */
+			ret = devm_add_action_or_reset(dev, rockchip_opp_put_clk,
+						   info->clks[i].clk);
+			if (ret) {
+				info->clks[i].clk = NULL;
+				goto out;
+			}
 		}
 		info->num_clks = num_clks;
 		ret = clk_bulk_prepare_enable(info->num_clks, info->clks);
@@ -1814,7 +1832,12 @@ next:
 				    &scale, &volt_sel);
 	if (info && info->data && info->data->set_soc_info)
 		info->data->set_soc_info(dev, np, bin, process, volt_sel);
-	rockchip_set_opp_prop_name(dev, process, volt_sel);
+	prop_table = rockchip_set_opp_prop_name(dev, process, volt_sel);
+	if (IS_ERR(prop_table)) {
+		ret = PTR_ERR(prop_table);
+		prop_table = NULL;
+		goto dis_opp_clk;
+	}
 	ret = dev_pm_opp_of_add_table(dev);
 	if (ret) {
 		dev_err(dev, "Invalid operating-points in device tree.\n");
@@ -1827,6 +1850,9 @@ next:
 dis_opp_clk:
 	if (info && info->clks)
 		clk_bulk_disable_unprepare(info->num_clks, info->clks);
+	/* Preserve the suffix for parsed OPPs; the last table put frees it. */
+	if (prop_table)
+		dev_pm_opp_put_opp_table(prop_table);
 out:
 	of_node_put(np);
 

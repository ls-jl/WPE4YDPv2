 #include <linux/pm_domain.h>
 #include <linux/regulator/consumer.h>
 
@@ -30,6 +31,47 @@ LIST_HEAD(opp_tables);
 /* Lock to allow exclusive modification to the device and opp lists */
 DEFINE_MUTEX(opp_table_lock);
 
+/* PM_OPP is built-in; these inert resources never depend on a GPU module. */
+static LIST_HEAD(opp_regulator_quarantined);
+static DEFINE_MUTEX(opp_regulator_quarantine_lock);
+
+static bool _opp_regulator_release_matches(struct opp_table *table,
+					  struct device *dev)
+{
+	struct device *held = table->regulator_release_dev;
+	const char *old_name;
+	const char *new_name;
+
+	if (held == dev)
+		return true;
+	if (table->regulator_release_path[0] && dev->of_node)
+		return !strcmp(table->regulator_release_path,
+			       of_node_full_name(dev->of_node));
+	old_name = dev_name(held);
+	new_name = dev_name(dev);
+	return held->bus == dev->bus && old_name && new_name &&
+	       !strcmp(old_name, new_name);
+}
+
+static bool _opp_regulator_release_blocked(struct device *dev)
+{
+	struct opp_table *table;
+	bool blocked = false;
+
+	if (IS_ERR_OR_NULL(dev))
+		return false;
+	mutex_lock(&opp_regulator_quarantine_lock);
+	list_for_each_entry(table, &opp_regulator_quarantined,
+			    regulator_release_node) {
+		if (_opp_regulator_release_matches(table, dev)) {
+			blocked = true;
+			break;
+		}
+	}
+	mutex_unlock(&opp_regulator_quarantine_lock);
+	return blocked;
+}

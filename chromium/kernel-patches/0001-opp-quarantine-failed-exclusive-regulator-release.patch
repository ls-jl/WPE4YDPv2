diff --git a/include/linux/pm_opp_safe.h b/include/linux/pm_opp_safe.h
new file mode 100644
index 0000000..97e458c
--- /dev/null
+++ b/include/linux/pm_opp_safe.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_PM_OPP_SAFE_H__
+#define __LINUX_PM_OPP_SAFE_H__
+
+#include <linux/pm_opp.h>
+
+#define DEV_PM_OPP_SAFE_REGULATOR_RELEASE 1
+#define DEV_PM_OPP_RELEASE_PATH_MAX 256
+
+#if defined(CONFIG_PM_OPP)
+int dev_pm_opp_check_regulator_release(struct device *dev);
+int dev_pm_opp_put_regulators_safe(struct device *dev,
+				 struct opp_table *table, bool *consumed);
+#else
+static inline int dev_pm_opp_check_regulator_release(struct device *dev)
+{
+	(void)dev;
+	return -EOPNOTSUPP;
+}
+
+static inline int dev_pm_opp_put_regulators_safe(struct device *dev,
+					      struct opp_table *table, bool *consumed)
+{
+	(void)dev;
+	(void)table;
+	if (consumed)
+		*consumed = false;
+	return -EOPNOTSUPP;
+}
+#endif
+#endif

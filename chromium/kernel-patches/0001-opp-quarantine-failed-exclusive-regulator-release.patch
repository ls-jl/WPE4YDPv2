 		return opp_table;
 
+	if (READ_ONCE(opp_table->regulator_release_pending)) {
+		dev_pm_opp_put_opp_table(opp_table);
+		return ERR_PTR(-EBUSY);
+	}
+
 	/* This should be called before OPPs are initialized */
 	if (WARN_ON(!list_empty(&opp_table->opp_list))) {
 		dev_pm_opp_put_opp_table(opp_table);

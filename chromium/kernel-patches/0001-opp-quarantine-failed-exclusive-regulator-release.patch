+/**
+ * dev_pm_opp_check_regulator_release() - Refuse a supply table being retired
+ * @dev: consumer device to check before acquiring new GPU resources
+ *
+ * Return: zero for no table or a normal table; -EBUSY for an in-progress or
+ * quarantined release. Other lookup errors are returned, not treated as ready.
+ */
+int dev_pm_opp_check_regulator_release(struct device *dev)
+{
+	struct opp_table *table;
+	int ret;
+
+	if (_opp_regulator_release_blocked(dev))
+		return -EBUSY;
+	table = _find_opp_table(dev);
+	if (IS_ERR(table))
+		return PTR_ERR(table) == -ENODEV ? 0 : PTR_ERR(table);
+	ret = READ_ONCE(table->regulator_release_pending) ? -EBUSY : 0;
+	dev_pm_opp_put_opp_table(table);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dev_pm_opp_check_regulator_release);
+
+/**
+ * dev_pm_opp_put_regulators_safe() - Consume or quarantine an exclusive table
+ * @dev: sole consumer, kept alive if regulator_disable fails
+ * @table: owned reference returned by dev_pm_opp_set_regulators
+ * @consumed: mandatory output; true only when ownership was transferred
+ *
+ * The caller must drain all rate/voltage IO, remove its OPPs and unregister its
+ * helper first. This API does not replace caller-side serialization. Unreturned
+ * custom-helper enables must be resolved separately: table->enabled describes
+ * committed core ownership only. Shared tables are deliberately unsupported.
+ *
+ * A precondition error leaves *consumed=false and the caller still owns its
+ * reference. After release starts, success or disable failure consumes it.
+ * Successful returns are recorded by NULLing each handle only after put. On a
+ * disable error the remaining handles, table and device reference stay on the
+ * built-in OPP list until reboot; no callback or late driver-module pin is used.
+ * The OF path is copied without allocation; overlong paths are rejected before
+ * IO, not truncated. Matching also covers recreated devices at that OF path.
+ * Do not mix this API with the legacy void release on the same reference.
+ *
+ * Return: zero on complete release, a negative regulator error on quarantine,
+ * or -EINVAL/-EBUSY/-EALREADY/-ENAMETOOLONG on rejected preconditions.
+ */
+int dev_pm_opp_put_regulators_safe(struct device *dev,
+				 struct opp_table *table, bool *consumed)
+{
+	int ret = 0;
+	int i;
+
+	if (!consumed)
+		return -EINVAL;
+	*consumed = false;
+	if (IS_ERR_OR_NULL(dev) || IS_ERR_OR_NULL(table))
+		return -EINVAL;
+	mutex_lock(&table->lock);
+	if (table->regulator_release_pending) {
+		ret = -EALREADY;
+		goto rejected;
+	}
+	if (table->shared_opp == OPP_TABLE_ACCESS_SHARED ||
+	    !list_is_singular(&table->dev_list) || !_find_opp_dev(dev, table)) {
+		ret = -EINVAL;
+		goto rejected;
+	}
+	if (!list_empty(&table->opp_list) || table->set_opp) {
+		ret = -EBUSY;
+		goto rejected;
+	}
+	if (dev->of_node && strscpy(table->regulator_release_path,
+				   of_node_full_name(dev->of_node),
+				   sizeof(table->regulator_release_path)) < 0) {
+		table->regulator_release_path[0] = '\0';
+		ret = -ENAMETOOLONG;
+		goto rejected;
+	}
+	WRITE_ONCE(table->regulator_release_pending, true);
+	table->regulator_release_dev = get_device(dev);
+	mutex_lock(&opp_regulator_quarantine_lock);
+	list_add_tail(&table->regulator_release_node, &opp_regulator_quarantined);
+	mutex_unlock(&opp_regulator_quarantine_lock);
+	mutex_unlock(&table->lock);
+
+	if (table->regulators) {
+		for (i = table->regulator_count - 1; i >= 0; --i) {
+			struct regulator *regulator = table->regulators[i];
+			int err;
+
+			if (!regulator)
+				continue;
+			err = table->enabled ? regulator_disable(regulator) : 0;
+			if (err) {
+				if (!ret)
+					ret = err;
+				continue;
+			}
+			regulator_put(regulator);
+			table->regulators[i] = NULL;
+		}
+	}
+	*consumed = true;
+	if (ret) {
+		dev_err(dev, "OPP supplies retained after failed disable: %d\n", ret);
+		return ret;
+	}
+
+	mutex_lock(&table->lock);
+	_free_set_opp_data(table);
+	kfree(table->regulators);
+	table->regulators = NULL;
+	table->regulator_count = -1;
+	table->enabled = false;
+	mutex_lock(&opp_regulator_quarantine_lock);
+	list_del_init(&table->regulator_release_node);
+	table->regulator_release_path[0] = '\0';
+	table->regulator_release_dev = NULL;
+	mutex_unlock(&opp_regulator_quarantine_lock);
+	WRITE_ONCE(table->regulator_release_pending, false);
+	mutex_unlock(&table->lock);
+	dev_pm_opp_put_opp_table(table);
+	put_device(dev);
+	return 0;
+
+rejected:
+	mutex_unlock(&table->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dev_pm_opp_put_regulators_safe);
+
 /**

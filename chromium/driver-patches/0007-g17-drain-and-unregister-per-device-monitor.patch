+void kbase_platform_rk_monitor_lock(struct kbase_device *kbdev,
+				  struct kbase_rk_monitor_guard *guard)
+{
+	struct rk_context *platform = get_rk_context(kbdev);
+
+	guard->platform = platform;
+	mutex_lock(&platform->monitor_refs_lock);
+	guard->info = kbdev->mdev_info;
+	if (guard->info)
+		atomic_inc(&platform->monitor_users);
+	mutex_unlock(&platform->monitor_refs_lock);
+	rockchip_monitor_volt_adjust_lock(guard->info);
+}
+
+void kbase_platform_rk_monitor_unlock(struct kbase_rk_monitor_guard *guard)
+{
+	struct rk_context *platform = guard->platform;
+
+	if (!guard->info)
+		return;
+	rockchip_monitor_volt_adjust_unlock(guard->info);
+	if (atomic_dec_and_test(&platform->monitor_users))
+		wake_up_all(&platform->monitor_idle);
+	guard->info = NULL;
+}
+
+bool kbase_platform_rk_monitor_checked(struct kbase_device *kbdev)
+{
+	return READ_ONCE(get_rk_context(kbdev)->monitor_checked);
+}
+
+void kbase_platform_rk_monitor_register(struct kbase_device *kbdev,
+				      const struct monitor_dev_profile *profile)
+{
+	struct rk_context *platform = get_rk_context(kbdev);
+	struct monitor_dev_profile *copy;
+	struct monitor_dev_info *info = NULL;
+
+	mutex_lock(&platform->monitor_publish_lock);
+	if (platform->monitor_checked)
+		goto out;
+	copy = kzalloc(sizeof(*copy), GFP_KERNEL);
+	if (copy) {
+		*copy = *profile;
+		copy->data = kbdev->devfreq;
+		copy->opp_info = &kbdev->opp_info;
+		info = rockchip_system_monitor_register(kbdev->dev, copy);
+		if (IS_ERR_OR_NULL(info)) {
+			kfree(copy);
+			copy = NULL;
+			info = NULL;
+		}
+	}
+	if (!info)
+		dev_dbg(kbdev->dev, "without system monitor\n");
+	platform->monitor_profile = copy;
+	mutex_lock(&platform->monitor_refs_lock);
+	kbdev->mdev_info = info;
+	mutex_unlock(&platform->monitor_refs_lock);
+	WRITE_ONCE(platform->monitor_checked, true);
+out:
+	mutex_unlock(&platform->monitor_publish_lock);
+}
+
+void kbase_platform_rk_monitor_unregister(struct kbase_device *kbdev)
+{
+	struct rk_context *platform = get_rk_context(kbdev);
+	struct monitor_dev_info *info;
+
+	mutex_lock(&platform->monitor_publish_lock);
+	WRITE_ONCE(platform->monitor_checked, false);
+	mutex_lock(&platform->monitor_refs_lock);
+	info = kbdev->mdev_info;
+	kbdev->mdev_info = NULL;
+	mutex_unlock(&platform->monitor_refs_lock);
+	/* No platform/devfreq or monitor-voltage lock is held across this wait. */
+	wait_event(platform->monitor_idle, !atomic_read(&platform->monitor_users));
+	if (info)
+		rockchip_system_monitor_unregister(info);
+	kfree(platform->monitor_profile);
+	platform->monitor_profile = NULL;
+	mutex_unlock(&platform->monitor_publish_lock);
+}

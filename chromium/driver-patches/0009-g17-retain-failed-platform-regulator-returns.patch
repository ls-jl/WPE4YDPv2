+/* No retry callback may refer to a kbdev after platform teardown. */
+static LIST_HEAD(rk_pm_quarantined);
+static DEFINE_MUTEX(rk_pm_quarantine_lock);
+
+static bool rk_pm_quarantine_active(void)
+{
+	bool active;
+
+	mutex_lock(&rk_pm_quarantine_lock);
+	active = !list_empty(&rk_pm_quarantined);
+	mutex_unlock(&rk_pm_quarantine_lock);
+	return active;
+}
+
+#ifdef CONFIG_REGULATOR
+static bool rk_pm_quarantine_regulators(struct kbase_device *kbdev,
+					struct rk_context *platform)
+{
+	unsigned int i;
+
+	if (!platform->regulator_owned_mask)
+		return false;
+	/* The pin was acquired before enable, never resurrected during remove. */
+	WARN_ON_ONCE(!platform->regulator_module_pinned);
+	platform->quarantine_dev = get_device(kbdev->dev);
+	for (i = 0; i < BASE_MAX_NR_CLOCKS_REGULATORS; ++i) {
+		if (!(platform->regulator_owned_mask & BIT(i)))
+			continue;
+		platform->quarantine_regulators[i] = kbdev->regulators[i];
+		kbdev->regulators[i] = NULL;
+	}
+	mutex_lock(&rk_pm_quarantine_lock);
+	list_add_tail(&platform->quarantine_node, &rk_pm_quarantined);
+	mutex_unlock(&rk_pm_quarantine_lock);
+	dev_err(kbdev->dev,
+		"GPU regulator return failed; resources retained until reboot\n");
+	return true;
+}
+#endif
+

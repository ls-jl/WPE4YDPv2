+#if MALI_OPP_REFERENCE_TRACKING
+static LIST_HEAD(kbase_opp_quarantined);
+static DEFINE_MUTEX(kbase_opp_quarantine_lock);
+
+bool kbase_opp_quarantine_active(void)
+{
+	bool active;
+
+	mutex_lock(&kbase_opp_quarantine_lock);
+	active = !list_empty(&kbase_opp_quarantined);
+	mutex_unlock(&kbase_opp_quarantine_lock);
+	return active;
+}
+
+static void kbase_opp_quarantine_failed(struct kbase_device *kbdev,
+				      struct kbase_opp_ref_state *state,
+				      struct opp_table *table)
+{
+	struct kbase_opp_quarantine *hold = state->quarantine;
+	unsigned int i;
+
+	/* Storage and the checked module guard precede every enable attempt. */
+	WARN_ON_ONCE(!hold || !state->module_pinned);
+	hold->dev = get_device(kbdev->dev);
+	hold->table = table;
+	hold->count = state->retained_count;
+	hold->module_pinned = state->module_pinned;
+	for (i = 0; i < state->retained_count; ++i) {
+		hold->retained[i] = state->retained[i];
+		state->retained[i] = NULL;
+	}
+	state->retained_count = 0;
+	state->module_pinned = false;
+	state->quarantine = NULL;
+	kbdev->opp_table = NULL;
+	mutex_lock(&kbase_opp_quarantine_lock);
+	list_add_tail(&hold->node, &kbase_opp_quarantined);
+	mutex_unlock(&kbase_opp_quarantine_lock);
+	dev_err(kbdev->dev, "OPP rollback retained independently until reboot\n");
+}
+#endif

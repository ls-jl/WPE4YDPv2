+#if MALI_OPP_REFERENCE_TRACKING
+struct kbase_opp_transition {
+	struct regulator *regulators[BASE_MAX_NR_CLOCKS_REGULATORS];
+	unsigned int count;
+	bool helper_entered;
+};
+
+static int kbase_devfreq_set_opp_rate(struct kbase_device *kbdev,
+				     unsigned long rate)
+{
+	struct kbase_opp_ref_state *state;
+	struct kbase_opp_transition transition = { { NULL }, 0, false };
+	bool release_module = false;
+	int ret;
+
+	/* This private DVFS entry accepts only recommended, nonzero OPPs. */
+	if (!kbdev || !rate)
+		return -EINVAL;
+	state = &kbdev->opp_ref_state;
+	if (!smp_load_acquire(&state->initialized))
+		return -EINVAL;
+	mutex_lock(&state->lock);
+	if (state->closing || state->retained_count || !try_module_get(THIS_MODULE)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	release_module = true;
+	state->transition = &transition;
+	WRITE_ONCE(state->owner, current);
+	ret = dev_pm_opp_set_rate(kbdev->dev, rate);
+	WRITE_ONCE(state->owner, NULL);
+	state->transition = NULL;
+	if (!ret)
+		WRITE_ONCE(kbdev->current_nominal_freq, rate);
+	if (!ret && transition.count) {
+		/* Only the OPP core may now return these enables at table teardown. */
+		state->regulators_committed = true;
+		transition.count = 0;
+	}
+	while (transition.count) {
+		struct regulator *regulator = transition.regulators[--transition.count];
+
+		if (regulator_disable(regulator)) {
+			state->retained[state->retained_count++] = regulator;
+			if (!state->module_pinned) {
+				state->module_pinned = true;
+				release_module = false;
+			}
+			dev_err(kbdev->dev, "OPP rollback failed; module retained\n");
+		}
+	}
+unlock:
+	mutex_unlock(&state->lock);
+	if (release_module)
+		module_put(THIS_MODULE);
+	return ret;
+}
+#else
+static int kbase_devfreq_set_opp_rate(struct kbase_device *kbdev,
+				     unsigned long rate)
+{
+	return dev_pm_opp_set_rate(kbdev->dev, rate);
+}
+#endif

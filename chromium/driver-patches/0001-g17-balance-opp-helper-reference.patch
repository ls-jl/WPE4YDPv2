From: Pen Browser maintainers
Subject: [SOURCE-ONLY CANDIDATE] mali: balance the pre-6.0 OPP helper reference

Base: rockchip-linux/kernel 25b2037af22f36400c9004481b9e44c02c30c8e1
Source: drivers/gpu/arm/bifrost/mali_kbase_core_linux.c
Source-SHA256: 20f9261a771a4be6dd393215a126b9c1d9631ce814afb46dc8fc39e9728fe78d
License: GPL-2.0 WITH Linux-syscall-note, as declared by the original file.

dev_pm_opp_set_regulators() and dev_pm_opp_register_set_opp_helper() each
return a reference to the device's OPP table. Do not overwrite the valid
regulator reference with an error pointer when helper registration fails.
On removal, unregister the helper before returning the regulator reference.
Clear the owning field so repeated partial teardown cannot return it twice.

This fixes helper-reference ownership, NOT the separate custom-helper /
regulator-enable ownership mismatch. It is not applied by any runtime builder.
It must not be used to justify loading an ABI-unmatched replacement module.

--- a/drivers/gpu/arm/bifrost/mali_kbase_core_linux.c
+++ b/drivers/gpu/arm/bifrost/mali_kbase_core_linux.c
@@ -4602,6 +4602,8 @@
 	}
 #elif (KERNEL_VERSION(4, 10, 0) <= LINUX_VERSION_CODE)
 	if (kbdev->nr_regulators > 0) {
+		struct opp_table *helper;
+
 		kbdev->opp_table =
 			dev_pm_opp_set_regulators(kbdev->dev, regulator_names,
 						  kbdev->nr_regulators);
@@ -4611,10 +4613,10 @@
 			dev_err(kbdev->dev, "Failed to set regulators\n");
 			return 0;
 		}
-		kbdev->opp_table =
+		helper =
 			dev_pm_opp_register_set_opp_helper(kbdev->dev,
 							   kbase_devfreq_opp_helper);
-		if (IS_ERR(kbdev->opp_table)) {
+		if (IS_ERR(helper)) {
 			dev_pm_opp_put_regulators(kbdev->opp_table);
 			kbdev->opp_table = NULL;
 			dev_err(kbdev->dev, "Failed to set opp helper\n");
@@ -4670,8 +4672,13 @@
 		dev_pm_opp_put_regulators(kbdev->token);
 	}
 #elif (KERNEL_VERSION(4, 10, 0) <= LINUX_VERSION_CODE)
-	if (!IS_ERR_OR_NULL(kbdev->opp_table))
-		dev_pm_opp_put_regulators(kbdev->opp_table);
+	if (!IS_ERR_OR_NULL(kbdev->opp_table)) {
+		struct opp_table *table = kbdev->opp_table;
+
+		kbdev->opp_table = NULL;
+		dev_pm_opp_unregister_set_opp_helper(table);
+		dev_pm_opp_put_regulators(table);
+	}
 #endif /* (KERNEL_VERSION(6, 0, 0) <= LINUX_VERSION_CODE) */
 #endif /* CONFIG_REGULATOR */
 #endif /* CONFIG_PM_OPP */
